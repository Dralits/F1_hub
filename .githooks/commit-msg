#!/bin/sh

COMMIT_MSG_FILE="$1"

if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
    echo "Error: no se encontró el fichero del mensaje de commit." >&2
    exit 1
fi

HEADER=$(head -n 1 "$COMMIT_MSG_FILE" | tr -d '\r')

case "$HEADER" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*)
        exit 0
        ;;
esac

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?!?: .+$'

if ! printf '%s\n' "$HEADER" | grep -Eq "$PATTERN"; then
    echo "" >&2
    echo "❌ Mensaje de commit inválido según Conventional Commits:" >&2
    echo "   \"$HEADER\"" >&2
    echo "" >&2
    echo "Formato esperado: <tipo>(<alcance opcional>): <descripción>" >&2
    echo "Tipos válidos: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert" >&2
    exit 1
fi

DESCRIPTION=$(printf '%s' "$HEADER" | sed -E 's/^[^:]+: //')

if printf '%s\n' "$DESCRIPTION" | grep -Eq '^[A-ZÁÉÍÓÚÜÑ]'; then
    echo "" >&2
    echo "❌ La descripción del commit debe empezar en minúscula:" >&2
    echo "   \"$HEADER\"" >&2
    echo "" >&2
    exit 1
fi

case "$DESCRIPTION" in
    *.)
        echo "" >&2
        echo "❌ La descripción del commit no debe terminar en punto (.):" >&2
        echo "   \"$HEADER\"" >&2
        echo "" >&2
        exit 1
        ;;
esac

if [ "${#HEADER}" -gt 100 ]; then
    echo "" >&2
    echo "❌ La primera línea del commit supera los 100 caracteres (${#HEADER}):" >&2
    echo "   \"$HEADER\"" >&2
    echo "" >&2
    exit 1
fi

exit 0
